<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project must depend on nothing but the BCL — no PackageReference, no ProjectReference.
    It is the compiler-enforced "wire/storage contract" boundary (see Heliograph.Contracts/CLAUDE.md):
    the HTTP request/response records, and the board/laser shapes that are also the jsonb columns.
    Enum-valued fields are strings on purpose — do not reference Heliograph.Engine to "type" them.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
