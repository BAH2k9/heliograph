<Project Sdk="Microsoft.NET.Sdk">

  <!--
    This project must depend on nothing but the BCL — no PackageReference, no ProjectReference.
    It is the compiler-enforced "pure rules engine" boundary (see Heliograph.Engine/CLAUDE.md). If you
    think you need a dependency here, you are almost certainly about to break that boundary.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    NuGet package metadata. The published version comes from the engine-v* tag
    (.github/workflows/engine-publish.yml passes -p:Version=...); the Version here is only what a local
    `dotnet pack` stamps.
  -->
  <PropertyGroup>
    <PackageId>Heliograph.Engine</PackageId>
    <Version>0.1.0</Version>
    <Authors>Heliograph contributors</Authors>
    <Description>The pure rules engine for Heliograph, a board game of mirrors and light: move legality, laser tracing, win detection, board layouts and rule variants. Deterministic, no I/O, no dependencies beyond the BCL.</Description>
    <PackageTags>heliograph;board-game;game-engine;laser;rules</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/BAH2k9/heliograph</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BAH2k9/heliograph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Ship the XML doc comments so consumers get IntelliSense. CS1591 (undocumented public member)
         is silenced: not every public member has a summary, and that shouldn't fail -warnaserror. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Heliograph.Engine.Tests" />
  </ItemGroup>

</Project>
