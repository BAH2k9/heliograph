# The api service builds from the repo root (see docker-compose.yml), so without
# this the daemon tars the whole tree — .git, every .claude/worktrees checkout,
# node_modules — on each build. Resolves against the build context, so the
# web service (context ./web) is unaffected.
.git
.github
.claude
.vs
**/bin
**/obj
web/node_modules
web/dist
plans
