POSTGRES_PASSWORD=changeme
JWT_SIGNING_KEY=changeme-generate-a-real-256-bit-secret-for-deploy
# Email of the account to promote to admin (IsAdmin = true) at every startup. Idempotent, and
# blank/unset disables the bootstrap entirely — see Heliograph.Api.Auth.AdminOptions.
Admin__BootstrapEmail=admin@example.invalid
# Cloudflare Tunnel connector token (Zero Trust dashboard -> Networks -> Tunnels -> your tunnel ->
# Install connector). Outbound-only; no inbound port is opened. See TLS-02.
CLOUDFLARE_TUNNEL_TOKEN=changeme-cloudflare-tunnel-connector-token
